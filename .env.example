# 复制本文件为 .env，然后填入真实值
QQ_BOT_APPID=你的AppID
QQ_BOT_SECRET=你的AppSecret

QQ_BOT_KEYWORD=
QQ_BOT_COOLDOWN=10
QQ_BOT_IMAGE_COOLDOWN=3
QQ_BOT_IDLE_TIMEOUT=3600

# 管理员口令：私聊发送「管理员 <口令>」即可把自己登记为管理员。
# 留空 = 关闭管理员登记。口令属于敏感信息，不要外传。
QQ_BOT_ADMIN_PASSWORD=

# ---- 人格聊天（可选，留空则机器人只处理指令）----
# 通义千问角色模型的 API Key（阿里云百炼 / DashScope）
QQ_BOT_QWEN_KEY=
QQ_BOT_QWEN_MODEL=qwen-flash-character

# 人格聊天的每会话最小回复间隔（秒），防止连点刷屏 / 烧 token；0 = 不限流
QQ_BOT_CHAT_COOLDOWN=5

# 对话记忆的两道限制：每会话最多多少条 + 上下文存活多少分钟（超时即过期）
QQ_BOT_CHAT_MEMORY=100
QQ_BOT_CHAT_MEMORY_MINUTES=20

# 调试用：把收到的原始事件落盘到 logs/raw_events.jsonl（排查 payload 结构时打开）
# QQ_BOT_DUMP_EVENTS=1

# ---- /help 转图片（可选）----
# 背景图不存在就自动退回纯文本。图片会渲染成 JPEG（约 370KB，3Mbps 上传约 1 秒），
# 在 QQ 里 QQ 会按宽度缩放，长文本显示得更紧凑。
# ⚠️ 背景图建议放 data/ 下 —— data/ 已被 .gitignore 忽略，
#    免得把别人的插画作品提交进公开仓库。
# QQ_BOT_HELP_BG=data/help_bg.jpg  ← 代码默认值就是这个，去掉注释即生效
# QQ_BOT_HELP_WIDTH=1280        画布宽度（越大 → QQ 里显示越小）
# QQ_BOT_HELP_FONTSIZE=28       字号
# QQ_BOT_HELP_ALPHA=120         面板不透明度（越小背景越透）
# QQ_BOT_HELP_QUALITY=72        JPEG 质量（85→72 体积降 1/3，肉眼几乎无差）

# ---- 游戏公告推送（明日方舟 / 终末地，可选）----
# 群里用 /公告 开|关 明日方舟|终末地|全部 按群独立开关（默认关）；
# /公告 查 [游戏] 随时被动查看最新公告，不受下面配置影响。
# 轮询间隔分钟；0 = 关闭主动推送（只保留 /公告 查）
# QQ_BOT_NEWS_POLL_MINUTES=10
# 主动推送的公告标题关键词（| 分隔）。
# ⚠️ 线上服务器配的是「更新|维护|停机|版本|活动预告」——活动预告也会推。
# 制作组通讯、寻访、未成年人限时通知这类仍不会打扰群，只能 /公告 查 看。
# QQ_BOT_NEWS_KEYWORDS=更新|维护|停机|版本|活动预告
# 每群每日主动推送上限（防解析 bug 刷屏的保险丝，正常用量远达不到）
# QQ_BOT_NEWS_DAILY_LIMIT=6

# 敏感词表路径（由 deploy/fetch_sensitive_words.sh 生成）。
# 文件不存在或为空 → 过滤自动禁用，不影响机器人启动。
# QQ_BOT_SENSITIVE_WORDS=/opt/qqbot/data/sensitive_words.txt
