# 复制本文件为 .env，然后填入真实值
QQ_BOT_APPID=你的AppID
QQ_BOT_SECRET=你的AppSecret

QQ_BOT_KEYWORD=
QQ_BOT_COOLDOWN=10
QQ_BOT_IMAGE_COOLDOWN=3
QQ_BOT_IDLE_TIMEOUT=3600

# 管理员口令：私聊发送「管理员 <口令>」即可把自己登记为管理员。
# 留空 = 关闭管理员登记。口令属于敏感信息，不要外传。
QQ_BOT_ADMIN_PASSWORD=

# ---- 人格聊天（可选，留空则机器人只处理指令）----
# 通义千问角色模型的 API Key（阿里云百炼 / DashScope）
QQ_BOT_QWEN_KEY=
QQ_BOT_QWEN_MODEL=qwen-flash-character

# 人格聊天的每会话最小回复间隔（秒），防止连点刷屏 / 烧 token；0 = 不限流
QQ_BOT_CHAT_COOLDOWN=5

# 全量消息模式下是否也触发人格聊天。
# ⚠️「@机器人」和「回复别人」都会在正文开头留下 <@openid>，无法可靠区分，
#    所以默认关闭；打开后「回复别人」的消息也会误触发。
QQ_BOT_CHAT_IN_ALL=

# 每会话保留的对话条数上限（人格聊天的记忆）
QQ_BOT_CHAT_MEMORY=100

# 敏感词表路径（由 deploy/fetch_sensitive_words.sh 生成）。
# 文件不存在或为空 → 过滤自动禁用，不影响机器人启动。
# QQ_BOT_SENSITIVE_WORDS=/opt/qqbot/data/sensitive_words.txt
