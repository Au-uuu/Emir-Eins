# 复制本文件为 .env，然后填入真实值
QQ_BOT_APPID=你的AppID
QQ_BOT_SECRET=你的AppSecret

QQ_BOT_KEYWORD=
QQ_BOT_COOLDOWN=10
QQ_BOT_IMAGE_COOLDOWN=3
QQ_BOT_IDLE_TIMEOUT=3600

# 管理员口令：私聊发送「管理员 <口令>」即可把自己登记为管理员。
# 留空 = 关闭管理员登记。口令属于敏感信息，不要外传。
QQ_BOT_ADMIN_PASSWORD=

# ---- 人格聊天（可选，留空则机器人只处理指令）----
# 通义千问角色模型的 API Key（阿里云百炼 / DashScope）
QQ_BOT_QWEN_KEY=
QQ_BOT_QWEN_MODEL=qwen-flash-character

# —— 可选：把「文本」单独换到别的厂商（OpenAI 兼容端点的都行）——
# 例：DeepSeek（https://api.deepseek.com/chat/completions）
# QQ_BOT_TEXT_KEY=sk-...
# QQ_BOT_TEXT_URL=https://api.deepseek.com/chat/completions
# QQ_BOT_TEXT_MODEL=deepseek-v4-pro        # 或 deepseek-flash

# 带图消息的视觉模型：用户发图时机器人能"看着图"回复（人设仍是同一张角色卡）。
# 默认 qwen3-vl-flash（同端点、同 Key）。QQ_BOT_QWEN_VL_MODEL=off 可整体关闭看图。
# QQ_BOT_QWEN_VL_MODEL=qwen3-vl-flash

# —— 可选：把「视觉」单独换到别的厂商（文本仍走上面的 DashScope）——
# 例：智谱 GLM-4.6V-Flash（免费，9B 视觉模型）。
# URL 与 KEY 必须成对配置；只配一个会被视为配置错误、自动禁用看图（避免拿 A 家 Key 调 B 家端点）。
# QQ_BOT_VL_MODEL=glm-4.6v-flash
# QQ_BOT_VL_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# QQ_BOT_VL_KEY=填智谱 API Key
# QQ_BOT_VL_IMAGE_FORMAT=base64        # 智谱要裸 base64（OpenAI/DashScope 才用 data_uri 前缀）
# QQ_BOT_VL_THINKING=disabled          # GLM-4.6V 系列：关思考模式，更快更省
# 两阶段看图：视觉模型只做「客观描述」，再由文本链路（qwen）转成人设回复；
# 打开后视频也会交给视觉模型（GLM 支持 video_url）。
# QQ_BOT_VL_DESCRIBE=1
# 视觉/描述超时（秒）：图片默认 60；视频默认 180（视频理解很慢，别用小超时）
# QQ_BOT_VL_TIMEOUT=60
# QQ_BOT_VL_VIDEO_TIMEOUT=180

# 人格聊天的每会话最小回复间隔（秒），防止连点刷屏 / 烧 token；0 = 不限流
QQ_BOT_CHAT_COOLDOWN=5

# 对话记忆的两道限制：每会话最多多少条 + 上下文存活多少分钟（超时即过期）
QQ_BOT_CHAT_MEMORY=100
QQ_BOT_CHAT_MEMORY_MINUTES=20

# 调试用：把收到的原始事件落盘到 logs/raw_events.jsonl（排查 payload 结构时打开）
# QQ_BOT_DUMP_EVENTS=1

# ---- /help 转图片（可选）----
# 背景图不存在就自动退回纯文本。图片会渲染成 JPEG（约 370KB，3Mbps 上传约 1 秒），
# 在 QQ 里 QQ 会按宽度缩放，长文本显示得更紧凑。
# ⚠️ 背景图建议放 data/ 下 —— data/ 已被 .gitignore 忽略，
#    免得把别人的插画作品提交进公开仓库。
# QQ_BOT_HELP_BG=data/help_bg.jpg  ← 代码默认值就是这个，去掉注释即生效
# QQ_BOT_HELP_WIDTH=1280        画布宽度（越大 → QQ 里显示越小）
# QQ_BOT_HELP_FONTSIZE=28       字号
# QQ_BOT_HELP_ALPHA=120         面板不透明度（越小背景越透）
# QQ_BOT_HELP_QUALITY=72        JPEG 质量（85→72 体积降 1/3，肉眼几乎无差）

# ---- 游戏公告推送（明日方舟 / 终末地，可选）----
# 群里用 /公告 开|关 明日方舟|终末地|全部 按群独立开关（默认关）；
# /公告 查 [游戏] 随时被动查看最新公告，不受下面配置影响。
# 轮询间隔分钟；0 = 关闭主动推送（只保留 /公告 查）
# QQ_BOT_NEWS_POLL_MINUTES=10
# 主动推送的公告标题关键词（| 分隔）。
# ⚠️ 线上服务器配的是「更新|维护|停机|版本|活动预告」——活动预告也会推。
# 制作组通讯、寻访、未成年人限时通知这类仍不会打扰群，只能 /公告 查 看。
# QQ_BOT_NEWS_KEYWORDS=更新|维护|停机|版本|活动预告
# 每群每日主动推送上限（防解析 bug 刷屏的保险丝，正常用量远达不到）
# QQ_BOT_NEWS_DAILY_LIMIT=6

# 敏感词表路径（由 deploy/fetch_sensitive_words.sh 生成）。
# 文件不存在或为空 → 过滤自动禁用，不影响机器人启动。
# QQ_BOT_SENSITIVE_WORDS=/opt/qqbot/data/sensitive_words.txt

# ---- 离线打标（看图链路的「识别线索」，可选）----
# 多模型注册表（见 tagger.py 的 MODELS），用 QQ_BOT_TAGGER_MODEL 选择：
#   camie            —— 默认。Camais03/camie-tagger-v2，512²，角色库 2.6 万+，含作品标签，免登录。
#   animetimm-swinv2 —— 可选，CPU 更快（256²），Danbooru v4，带每标签 best_threshold；
#                       仅角色无作品，GPL-3.0 且需 HF 登录同意条款后下载。
# 模型目录默认 models/<注册表目录>/；文件缺失 → 打标静默禁用，看图照常。
# QQ_BOT_TAGGER_MODEL=camie
# QQ_BOT_TAGGER_DIR=models/camie-tagger-v2
# 角色 / 作品标签阈值（默认按模型；越低召回越多、误报越多，可用统一值一次性覆盖两者）
# QQ_BOT_TAGGER_CHAR_THRESHOLD=0.5
# QQ_BOT_TAGGER_COPYRIGHT_THRESHOLD=0.5
# QQ_BOT_TAGGER_THRESHOLD=0.5
# 标签中文名词库（Danbooru 中英对照，见 names.py）；默认 data/tag_zh.sqlite，缺文件则不做中文对照
# QQ_BOT_TAG_ZH_DB=data/tag_zh.sqlite

# ---- 本地知识库检索（RAG，可选）----
# 把「机器人该知道的事实」写成 data/kb/*.md / *.txt（以 _ 开头的文件不参与检索）；
# 用户提问时检索相关段落拼进提示词，让事实更准。纯本地 BM25，无第三方依赖；改文件需重启。
# 目录不存在/为空则自动跳过。
# QQ_BOT_KB_DIR=data/kb
# QQ_BOT_KB_TOP=3
# QQ_BOT_KB_MIN_SCORE=1.5

# ---- 联网搜索（两步式，可选）----
# 命中时效性提问时，单独调用一个「能联网」的模型取一段事实摘要，再注入角色模型；
# 不把检索原文塞进人设 prompt，人设更稳、也更省 token。默认关闭。
# 触发词只认「话题/意图」（新闻/价格/什么时候/发布/更新…），可用正则整体覆盖。
# QQ_BOT_WEBSEARCH=1
# QQ_BOT_WEBSEARCH_MODEL=qwen-flash
# QQ_BOT_WEBSEARCH_TRIGGERS=新闻|头条|动态|进展|消息|什么时候|多少钱|价格|发布|更新
# QQ_BOT_WEBSEARCH_TIMEOUT=25
# 密钥/端点留空则复用 QQ_BOT_QWEN_KEY / QQ_BOT_QWEN_URL
# QQ_BOT_WEBSEARCH_KEY=
# QQ_BOT_WEBSEARCH_URL=

# ---- R6 战绩查询（可选）----
# 走 R6 Arenyze 的公开 REST API（在 https://r6.arenyze.com 注册后于 Dashboard 生成 key）。
# 填了 QQ_BOT_R6_KEY 才会启用 /r6 指令；免费额度 2000 次/月（结果有 5 分钟缓存）。
# QQ_BOT_R6_KEY=
# QQ_BOT_R6_TIMEOUT=25
# key 到期日（YYYY-MM-DD）；到期/临近时私聊提醒管理员（见下「管理员汇报」）
# QQ_BOT_R6_KEY_EXPIRE=

# ---- 管理员汇报（可选）----
# 定时检查「需要人处理的事」并主动私聊管理员（首个检查项：R6 key 过期）。
# 间隔分钟（0=关闭，默认 720=12 小时）；提前几天开始提醒（默认 7）。
# 注：走主动私聊（post_c2c_message），可能受平台主动消息策略影响，失败只记日志。
# QQ_BOT_NOTICE_MINUTES=720
# QQ_BOT_NOTICE_WARN_DAYS=7
